$C = "../Common.ui";

$C.@PageOverlay {}
$C.@Container {
  Anchor: (Width: 600, Height: 330);
  #Title { Label #TitleText { Style: (RenderBold: true, FontSize: 20, TextColor: #ffffff); Anchor: (Left: 20); Text: ""; } }
  #Content {
    LayoutMode: Top;
    Label #Intro { Style: (TextColor: #ffffff(0.6), RenderItalics: true, Wrap: true); Anchor: (Left: 8, Bottom: 14); }
    $C.@TextButton #PadButton { Text: ""; Anchor: (Top: 8, Height: 44); }
    Label #PadText { Style: (TextColor: #ffffff(0.6), RenderItalics: true, Wrap: true); Anchor: (Left: 8, Top: 4); }
    $C.@TextButton #FullButton { Text: ""; Anchor: (Top: 8, Height: 44); }
    Label #FullText { Style: (TextColor: #ffffff(0.6), RenderItalics: true, Wrap: true); Anchor: (Left: 8, Top: 4); }
    $C.@TextButton #CloseButton { Text: ""; Anchor: (Top: 8, Height: 44); }
  }
}
$C.@BackButton {}
