# Objets
# Montgolfière
orbis_horizon.items.hotair_balloon_crate.name = Caisse de montgolfière
orbis_horizon.items.hotair_balloon_crate.description = Déploie une grande montgolfière. Demande un espace libre de 25 x 25 x 40 blocs.
orbis_horizon.items.hotair_balloon_basic_crate.name = Caisse de petite montgolfière
orbis_horizon.items.hotair_balloon_basic_crate.description = Déploie une petite montgolfière monoplace. Demande un espace libre de 7 x 14 x 7 blocs.
orbis_horizon.items.hotair_balloon_transport_crate.name = Caisse de montgolfière de transport
orbis_horizon.items.hotair_balloon_transport_crate.description = Déploie une montgolfière pour un pilote et un passager, avec une cage en fer suspendue sous la nacelle. Demande un espace libre de 23 x 41 x 23 blocs.
orbis_horizon.items.cage_lever.name = Levier de la cage
orbis_horizon.items.cage_lever.description = Levier de la montgolfière de transport. Actionnez-le pour descendre la cage (montgolfière en l'air, pan fermé), la remonter ou l'arrêter pendant son mouvement.
orbis_horizon.items.cage_gate_lever.name = Levier du pan de la cage
orbis_horizon.items.cage_gate_lever.description = Levier de la montgolfière de transport. Actionnez-le pour ouvrir ou fermer la face avant de la cage, quand la cage est immobile et que son plancher repose sur le sol. La fermer capture les animaux passifs qui sont dedans.
orbis_horizon.items.hotair_balloon_chain.name = Chaîne du brûleur de montgolfière
orbis_horizon.items.hotair_balloon_chain.description = Tirez-la pour décoller. En vol, tirez-la de nouveau pour arrêter la montgolfière et la poser sur place.
orbis_horizon.items.hotair_balloon_burner.name = Brûleur de montgolfière
orbis_horizon.items.hotair_balloon_burner.description = Réservoir de combustible de la montgolfière. Mettez-y du bois ou du charbon avant de décoller. Une flamme en sort tant qu'il a du combustible. Il brûle en vol et peut laisser du charbon en sortie.
orbis_horizon.items.hotair_balloon_large_burner.name = Brûleur de grande montgolfière
orbis_horizon.items.hotair_balloon_large_burner.description = Brûleur renforcé conçu pour la grande montgolfière. Il faut l'avoir pour fabriquer la caisse de la grande montgolfière.
orbis_horizon.items.hotair_balloon_brazier.name = Brasero de montgolfière
orbis_horizon.items.hotair_balloon_brazier.description = Inutilisé depuis que le brûleur porte lui-même la flamme. Peut être supprimé.
orbis_horizon.items.airship_cloudwork_crate.name = Caisse du dirigeable Cloudwork
orbis_horizon.items.airship_cloudwork_crate.description = Déploie le dirigeable Cloudwork. Ses propulseurs tournent grâce au noyau du Goblitérateur. Demande un espace libre de 11 x 17 x 31 blocs.
orbis_horizon.items.steamboat_crate.name = Caisse de bateau à vapeur
orbis_horizon.items.steamboat_crate.description = Déploie un bateau à vapeur à roues sur l'eau. Visez l'eau là où doit se trouver la poupe. Demande un espace libre de 15 x 14 x 28 blocs.
orbis_horizon.items.steamboat_skiff_crate.name = Esquif
orbis_horizon.items.steamboat_skiff_crate.description = Déploie sur l'eau un petit bateau à hélice que vous pilotez vous-même. Visez l'eau là où doit se trouver la poupe. Demande un espace libre de 5 x 5 x 9 blocs.
orbis_horizon.items.steamboat_skiff_crate_placed.name = Caisse de l'esquif
orbis_horizon.items.steamboat_skiff_crate_placed.description = Utilisez-la pour ranger l'esquif dans une caisse, avec le contenu de son coffre.
orbis_horizon.items.airship_helm.name = Barre
orbis_horizon.items.airship_helm.description = Actionnez-la depuis la place du pilote pour partir, puis de nouveau en route pour vous arrêter.
orbis_horizon.items.steamboat_paddle_wheel.name = Roue à aubes
orbis_horizon.items.steamboat_paddle_wheel.description = Une grande roue à aubes pour le flanc d'un bateau à vapeur. Elle prend beaucoup de place.
orbis_horizon.items.steamboat_propeller.name = Hélice
orbis_horizon.items.steamboat_propeller.description = Une hélice de bronze au bout de l'arbre de poupe d'un petit bateau.
orbis_horizon.items.ship_wheel.name = Barre de navire
orbis_horizon.items.ship_wheel.description = Une barre de navire en bois doré sur son pied, pour décorer un pont ou un port.
orbis_horizon.interactionHints.helmTakeOff = Appuyez sur [{key}] pour prendre la barre et décoller
orbis_horizon.interactionHints.deskMap = Appuyez sur [{key}] pour choisir une destination
orbis_horizon.interactionHints.chainTakeOff = Appuyez sur [{key}] pour tirer la chaîne et décoller
orbis_horizon.items.airship_engine.name = Moteur
orbis_horizon.items.airship_engine.description = Moteur placé sous le réservoir. Il rougeoie tant que le réservoir au-dessus a du combustible.
orbis_horizon.items.airship_fuel_tank.name = Réservoir
orbis_horizon.items.airship_fuel_tank.description = Réservoir du moteur. Mettez-y du bois ou du charbon avant de partir. Le moteur ne brûle du combustible que quand le véhicule avance ou tourne. Il peut laisser du charbon en sortie.
orbis_horizon.items.airship_burner_outlet.name = Sortie de brûleur du dirigeable
orbis_horizon.items.airship_burner_outlet.description = Sortie de brûleur arrière qui propulse le dirigeable. Il en faut deux pour construire un dirigeable.
orbis_horizon.items.hotair_balloon_public_burner.name = Brûleur de montgolfière de transport en commun
orbis_horizon.items.hotair_balloon_public_burner.description = Brûleur des montgolfières de transport en commun qui circulent entre les stations. Il n'a pas d'emplacement de combustible : la flamme reste allumée.
orbis_horizon.items.balloon_station_marker.name = Repère de station de montgolfière
orbis_horizon.items.balloon_station_marker.description = Brasero qui repère une station de montgolfière. Il fait partie de la station et ne se fabrique pas.
orbis_horizon.items.balloon_station_brazier.name = Brasero de station de montgolfière
orbis_horizon.items.balloon_station_brazier.description = Brasero d'une station de montgolfière. Sa flamme ne brûle pas et ne s'éteint pas.
orbis_horizon.items.balloon_station_map.name = Carte de la station
orbis_horizon.items.balloon_station_map.description = Carte d'une station de montgolfière. Simple décor : elle ne gêne pas l'accès au chef de gare.
# Tente de camping
orbis_horizon.items.camping_tent_crate.name = Petite Tente (ancienne caisse)
orbis_horizon.items.camping_tent_crate.description = Clic droit sur le sol pour monter une tente avec un lit et un feu de camp. La caisse vide reste dans votre inventaire.
orbis_horizon.items.camping_tent_crate_empty.name = Petite Tente (ancienne caisse vide)
orbis_horizon.items.camping_tent_crate_empty.description = Clic droit sur votre tente pour la ranger dans cette caisse.
orbis_horizon.items.camping_tent_big_crate.name = Grande Tente (ancienne caisse)
orbis_horizon.items.camping_tent_big_crate.description = Clic droit sur le sol pour monter une grande tente avec deux lits, deux coffres et un feu de camp. La caisse vide reste dans votre inventaire.
orbis_horizon.items.camping_tent_big_crate_empty.name = Grande Tente (ancienne caisse vide)
orbis_horizon.items.camping_tent_big_crate_empty.description = Clic droit sur votre tente pour la ranger dans cette caisse.
orbis_horizon.items.camping_tent_decor_ladder.name = Échelle de décor de tente
orbis_horizon.items.camping_tent_decor_ladder.description = Décor de la grande tente. Elle ressemble à une échelle mais on ne peut pas la grimper. C'est un panneau plein et fin qui peut gêner le passage.
orbis_horizon.items.airship_inkwell.name = Encrier
orbis_horizon.items.airship_inkwell.description = Encrier. Il n'a pas de collision, il ne gêne donc jamais le passage.
orbis_horizon.items.airship_chair.name = Chaise
orbis_horizon.items.airship_chair.description = Chaise. On peut s'y asseoir, et elle n'a pas de collision.
orbis_horizon.items.airship_stool.name = Tabouret
orbis_horizon.items.airship_stool.description = Siège des passagers. On peut s'y asseoir, et il n'a pas de collision.
# Messages de chat envoyés par le plugin
orbis_horizon.chat.takeoff.chain = Décollage ! Actionnez de nouveau la chaîne pour vous arrêter et poser la montgolfière sur place.
orbis_horizon.chat.takeoff.command = Décollage ! Actionnez la chaîne ou utilisez /orbishorizon balloon land pour atterrir.
orbis_horizon.chat.landed = Atterrissage réussi.
orbis_horizon.chat.stopped = Montgolfière immobilisée. En l'air, le brûleur continue de brûler et, à sec, elle redescend seule. Actionnez la chaîne pour repartir.
orbis_horizon.chat.landFailedContinue = {error} Le vol continue.
orbis_horizon.chat.seated = Vous êtes assis dans la nacelle. Vous serez posé à l'atterrissage.
orbis_horizon.chat.landedStandUp = La montgolfière est posée, vous pouvez vous lever.
orbis_horizon.chat.pilotDied = Le pilote est mort : la montgolfière descend toute seule jusqu'au sol.
orbis_horizon.chat.pilotDiedTakeOver = Le pilote est mort, vous pouvez prendre sa place pour continuer votre voyage.
orbis_horizon.chat.pilotLeft = Le pilote a quitté le véhicule : la montgolfière descend toute seule jusqu'au sol.
orbis_horizon.chat.fuel.dryDescentStart = Brûleur à sec : la montgolfière redescend toute seule jusqu'au sol, vous êtes assis. Elle se posera au contact du sol.
orbis_horizon.chat.fuel.dryLanded = Montgolfière posée, brûleur à sec. Remettez du combustible pour repartir.
orbis_horizon.chat.error.alreadyPiloting = Vous pilotez déjà une montgolfière.
orbis_horizon.chat.error.notPiloting = Vous ne pilotez pas de montgolfière.
orbis_horizon.chat.error.prefabUnreadable = Prefab de la montgolfière illisible : {error}
orbis_horizon.chat.error.noPosition = Position du joueur inconnue.
orbis_horizon.chat.error.noBalloon = Aucune montgolfière posée trouvée autour de vous. Montez dans la nacelle.
orbis_horizon.chat.error.noBurner = Brûleur introuvable. Cette montgolfière date peut-être d'une ancienne version du mod : posez-en une nouvelle avec une caisse.
orbis_horizon.chat.error.burnerEmpty = Le brûleur est vide. Mettez du combustible (bois, planches, charbon...) dans le brûleur, le tuyau au-dessus de la chaîne, puis réessayez.
orbis_horizon.chat.error.balloonFull = Cette montgolfière transporte {max, plural, one {1 personne} other {{max} personnes}} au plus, le pilote compris. Faites descendre {extra, plural, one {1 joueur} other {{extra} joueurs}} puis réessayez.
orbis_horizon.chat.error.movement = Impossible de modifier les déplacements du joueur.
orbis_horizon.chat.error.modelMissing = Modèle {model} introuvable. Les blocs ont été remis en place.
orbis_horizon.chat.error.unknownModel = Modèle inconnu : {model}
orbis_horizon.chat.error.noRoom = Pas assez de place ici pour poser la montgolfière.
orbis_horizon.chat.error.groundCage = La montgolfière descend sur sa cage. Attendez qu'elle se pose.
orbis_horizon.chat.despawn.none = Aucune montgolfière à moins de {radius} blocs.
orbis_horizon.chat.despawn.chunks = La montgolfière est en partie hors des chunks chargés. Approchez-vous.
orbis_horizon.chat.despawn.alreadyLanding = Cette montgolfière est déjà en train d'atterrir.
orbis_horizon.chat.despawn.done = Montgolfière retirée. Le contenu est tombé au sol, la caisse est dans votre inventaire.
orbis_horizon.chat.despawn.doneInventoryFull = Montgolfière retirée. Le contenu et la caisse sont tombés au sol (inventaire plein).
orbis_horizon.chat.despawn.removedByAdmin = La montgolfière a été retirée par un administrateur.
orbis_horizon.chat.lock.balloon.break = Cette montgolfière est verrouillée : on ne peut pas retirer ses blocs.
orbis_horizon.chat.lock.balloon.place = Cette montgolfière est verrouillée : on ne peut pas poser de bloc dessus ni dans la nacelle.
orbis_horizon.chat.lock.tent.break = Cette tente est verrouillée : on ne peut pas retirer ses blocs.
orbis_horizon.chat.lock.tent.place = Cette tente est verrouillée : on ne peut pas poser de bloc dessus ni dessous.
orbis_horizon.chat.lock.station.break = Cette station est verrouillée : on ne peut pas retirer ses blocs.
orbis_horizon.chat.lock.station.place = Cette station est verrouillée : on ne peut pas poser de bloc dessus ni dedans.
orbis_horizon.chat.lock.boatStation.break = Cette station maritime est verrouillée : on ne peut pas retirer ses blocs.
orbis_horizon.chat.lock.boatStation.place = Cette station maritime est verrouillée : on ne peut pas poser de bloc dessus ni dedans.
orbis_horizon.chat.tent.noRoom = Pas assez de place pour la tente.
orbis_horizon.chat.tent.packUnreadable = Le contenu de ce sac est illisible, il reste fermé.
orbis_horizon.chat.error.heightLimit = La montgolfière ne peut pas être posée ici : une partie dépasserait la limite de hauteur du monde.
orbis_horizon.chat.heightLimit.reached = La limite de hauteur du monde est atteinte : le véhicule ne peut pas aller plus haut.
orbis_horizon.chat.deploy.heightLimit = Pas assez de hauteur ici : une partie de la structure dépasserait la limite de hauteur du monde. Rien n'a été posé.
orbis_horizon.chat.deploy.underwater = Impossible de poser ceci sous l'eau : placez-vous sur la terre ferme.
orbis_horizon.chat.deploy.stationZone = Trop près du quai de {station}, posez-vous plus loin.
orbis_horizon.chat.gameMode.left = Vous avez quitté le véhicule parce que votre mode de jeu a changé.
orbis_horizon.chat.tent.aimTent = Visez une tente posée.
orbis_horizon.chat.tent.notOwner = Seul le joueur qui a posé cette tente peut la ranger.
orbis_horizon.chat.tent.approach = Approchez-vous de la tente.
orbis_horizon.chat.tent.packed = Tente rangée.
orbis_horizon.chat.tent.packedDropped = Tente rangée. Son contenu est tombé au sol.
orbis_horizon.chat.tent.packedKept = Tente rangée. Son contenu est dans la caisse.
orbis_horizon.chat.camp.crouchToPitch = Accroupissez-vous pour poser le campement.
orbis_horizon.chat.camp.packed = Campement rangé.
orbis_horizon.chat.camp.packedKept = Campement rangé. Vos affaires sont dans le sac.
orbis_horizon.chat.camp.packInChest = Un sac de campement ne peut pas être rangé dans une tente. Il a été posé au sol.
orbis_horizon.chat.camp.droppedAtFeet = Campement rangé. Votre inventaire est plein, le sac est tombé à vos pieds.
orbis_horizon.chat.camp.notOwner = Seul le joueur qui a monté ce campement peut le ranger.
orbis_horizon.chat.camp.bagBlocked = Le sac de ce campement est bloqué par un autre bloc. Utilisez /orbishorizon camping pack près de lui pour ranger le campement.
orbis_horizon.chat.camp.noneNearby = Aucun campement à portée.
orbis_horizon.chat.camp.respawnForgotten = Ce lieu de réveil est oublié.
orbis_horizon.chat.camp.respawnNotFound = Aucun lieu de réveil de campement ici.
orbis_horizon.chat.camp.approach = Approchez-vous du campement.
orbis_horizon.chat.camp.notACamp = Ceci n'est pas un campement que vous pouvez ranger.
orbis_horizon.chat.discovery.learned = Vous avez appris à fabriquer : {name}. Établi de mobilier.
orbis_horizon.chat.discovery.added = Ajouté à votre carnet : {name}.
orbis_horizon.chat.discovery.known = {name} est déjà dans votre carnet.
orbis_horizon.chat.discovery.newPage = Nouvelle page dans votre carnet : {family}.
orbis_horizon.chat.discovery.titleEarned = Titre obtenu : {title}
orbis_horizon.chat.discovery.nothing = Rien à noter sur ce bloc.
orbis_horizon.chat.discovery.disabled = La découverte des meubles est désactivée sur ce serveur.
orbis_horizon.chat.discovery.family.lost_civilization.name = Civilisation perdue
orbis_horizon.chat.discovery.family.lost_civilization.lore = Bien avant les premiers villages, un peuple bâtissait en pierre et en bois sombre. Il n'en reste que des ruines envahies par la mousse, des portes qui ne mènent plus nulle part et des statues sans visage. Chaque meuble retrouvé est une pièce du puzzle.
orbis_horizon.chat.discovery.family.village.name = Village
orbis_horizon.chat.discovery.family.village.lore = Les villages d'Orbis vivent au rythme des récoltes et des marchés. Leurs meubles sont simples et solides, faits pour durer plusieurs générations. Les habitants laissent volontiers un voyageur s'asseoir à leur table.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Bed = Le cadre a tenu, la paillasse est retournée à la poussière depuis longtemps.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Brazier = Les cendres au fond sont froides depuis des siècles.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Chair = Une chaise de conseil, peut-être. Elle attend encore quelqu'un.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Chest_Small = Vide, mais la serrure a été forcée de l'intérieur.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Door = Le bois a gonflé, la porte ne ferme plus vraiment.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Ladder = Les barreaux sont usés au milieu par des milliers de pas.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Sign = Les lettres sont effacées. Personne ne sait plus ce qu'il annonçait.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Stool = Assez solide pour qu'on s'y asseye encore.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Table = Des entailles régulières sur le plateau. Un compte, ou un calendrier.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Wardrobe = Une odeur de cèdre flotte encore à l'intérieur.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Window = On voyait le ciel par là, on le voit encore.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Banner = Le symbole a pâli, mais le fil d'or brille toujours.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Banner_Double = Deux bannières pour deux maisons alliées.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Banner_Triple = Trois bannières côte à côte. Une salle d'importance.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Bench = Un banc de pierre et de bois où l'on attendait d'être reçu.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Bookshelf = Les livres sont illisibles, mais quelqu'un les a rangés par taille.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Candle = La cire a coulé jusqu'au sol puis s'est figée.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Coffin = Le couvercle porte un nom gravé que plus personne ne sait lire.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Desk = Des taches d'encre sur le bois. Quelqu'un écrivait beaucoup ici.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Door_Large = Une porte faite pour impressionner ceux qui la franchissaient.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Door_Medium = Assez large pour faire passer une charrette, à condition de pousser fort.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Lantern = Le verre est fêlé, la mèche n'attend qu'une étincelle.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Lantern_Ceiling = Elle éclairait une salle où l'on parlait fort et longtemps.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Planter = Les plantes d'origine ont disparu, d'autres ont pris leur place.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Platform = Une estrade. Quelqu'un s'y tenait pour être vu.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Pot = Un fond de grain fossilisé colle encore aux parois.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Pot_Small = Assez petit pour tenir dans la main, assez solide pour avoir survécu.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Shelf = Des cercles de poussière marquent où se tenaient des bocaux.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Statue = Un gardien sans visage, toujours tourné vers l'entrée.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Statue_Broken = La tête manque. On ne l'a jamais retrouvée.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Torch = Le support a été scellé dans la pierre pour durer.
orbis_horizon.chat.discovery.item.Furniture_Human_Ruins_Trapdoor = Elle s'ouvre sur un escalier que personne n'a descendu depuis longtemps.
orbis_horizon.chat.discovery.item.Furniture_Village_Bed = Un lit simple, une couverture épaisse, et le sommeil vient tout seul.
orbis_horizon.chat.discovery.item.Furniture_Village_Brazier = On s'y réchauffe les mains les soirs de marché.
orbis_horizon.chat.discovery.item.Furniture_Village_Painting_1x1 = Un petit portrait d'ancêtre, accroché près de la porte.
orbis_horizon.chat.discovery.item.Furniture_Village_Bench = Le banc où les anciens commentent le passage des voyageurs.
orbis_horizon.chat.discovery.item.Furniture_Village_Bookcase = Des almanachs, des recettes, et un seul roman lu par tout le village.
orbis_horizon.chat.discovery.item.Furniture_Village_Coffin = Le menuisier en garde toujours un d'avance. On ne sait jamais.
orbis_horizon.chat.discovery.item.Furniture_Village_Painting_1x2 = Un paysage de collines, peint par un voyageur de passage.
orbis_horizon.chat.discovery.item.Furniture_Village_Painting_2x1 = Une scène de moisson, toute en ocres et en jaunes.
orbis_horizon.chat.discovery.item.Furniture_Village_Painting_2x2 = Le village tel qu'il était il y a cent ans. Rien n'a vraiment changé.
orbis_horizon.chat.discovery.item.Furniture_Village_Painting_3x2 = La grande fresque de la fondation, offerte par le premier maire.
orbis_horizon.chat.discovery.item.Furniture_Village_Pot = Il sent encore la soupe d'hier.
orbis_horizon.chat.discovery.item.Furniture_Village_Statue = Le héros du village. Personne n'est d'accord sur ses exploits.
orbis_horizon.chat.discovery.item.Furniture_Village_Tombstone = Des fleurs fraîches sont posées au pied de la pierre.
orbis_horizon.chat.discovery.family.lost_civilization.title = Archéologue des ruines
orbis_horizon.chat.discovery.family.village.title = Ami des villages
orbis_horizon.chat.discovery.family.feran.name = Feran
orbis_horizon.chat.discovery.family.feran.lore = Les Feran bâtissent près du sol, avec du bois clair, des cordes et des peaux tendues. Leurs maisons sentent la fumée et les herbes séchées. On y voit des objets faits pour être déplacés vite, mais réparés avec soin.
orbis_horizon.chat.discovery.family.feran.title = Ami des Feran
orbis_horizon.chat.discovery.item.Furniture_Feran_Bench = Le bois est lissé par des générations de conversations du soir.
orbis_horizon.chat.discovery.item.Furniture_Feran_Bookshelf = Des rouleaux ficelés, rangés selon un ordre que seul le propriétaire comprend.
orbis_horizon.chat.discovery.item.Furniture_Feran_Door = Un simple rabat bien tendu. Il tient le vent dehors, pas les curieux.
orbis_horizon.chat.discovery.item.Furniture_Feran_Ladder = Chaque échelon est noué à la main, jamais deux fois de la même façon.
orbis_horizon.chat.discovery.item.Furniture_Feran_Platform = Une plateforme légère, pensée pour être démontée avant la prochaine migration.
orbis_horizon.chat.discovery.item.Furniture_Feran_Pot = Un vase rond, gravé de spirales. Il sent encore les herbes amères.
orbis_horizon.chat.discovery.item.Furniture_Feran_Pot_Secondary = Plus petit que son jumeau, mais bien plus usé. On s'en servait tous les jours.
orbis_horizon.chat.discovery.item.Furniture_Feran_Shelf = Trois planches, quelques cordes, et assez de place pour tout un campement.
orbis_horizon.chat.discovery.item.Furniture_Feran_Sign = Des symboles peints à la hâte. Ils indiquent un chemin, ou un avertissement.
orbis_horizon.chat.discovery.item.Furniture_Feran_Stool = Un tabouret bas, parfait pour surveiller le feu sans trop se fatiguer.
orbis_horizon.chat.discovery.item.Furniture_Feran_Table = Les marques de couteau forment une carte, ou peut-être un jeu.
orbis_horizon.chat.discovery.item.Furniture_Feran_Trapdoor = Elle cache une réserve de vivres. Les voisins sont censés ne pas le savoir.
orbis_horizon.chat.discovery.item.Furniture_Feran_Wardrobe = Des peaux pliées, des plumes de fête et une odeur de cèdre.
orbis_horizon.chat.discovery.item.Furniture_Feran_Window = Une ouverture étroite, tournée vers l'est pour guetter le premier jour.
orbis_horizon.chat.discovery.family.scarak_temple.name = Temple Scarak primordial
orbis_horizon.chat.discovery.family.scarak_temple.lore = Avant les ruches, les Scarak dressaient des temples de pierre ocre dans le désert. Les salles sont étroites, les plafonds bas, les motifs répétés à l'infini. On a l'impression d'être observé par quelque chose de très ancien.
orbis_horizon.chat.discovery.family.scarak_temple.title = Fouilleur du sable
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Brazier = Une coupe de pierre noircie. Quelqu'un entretenait ce feu avant même les ruches.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Chest_Small = Un petit coffre de pierre, gravé de lignes si fines qu'on les devine au toucher.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Door_Large = Elle s'ouvre sur une salle où personne ne devait entrer sans y être invité.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Door_Medium = Les gonds ont gardé un peu de sable, comme si on l'avait ouverte hier.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Ladder = Les prises sont creusées dans la pierre, à la mesure de pattes plus que de mains.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Lamp = Une lueur ambrée dort encore à l'intérieur, patiente comme la pierre.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Lantern = Suspendue au plafond, elle éclairait des cérémonies dont il ne reste que l'écho.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Planter = Une plante têtue pousse dans le sable de la jardinière, sans que personne ne l'arrose.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Platform = Une dalle surélevée, usée en son centre par ceux qui s'y tenaient pour prier.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Pot = Les parois épaisses ont gardé la fraîcheur d'une cave, même en plein désert.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Secondary_Pot = Un autre vase, plus plat. On y laissait peut-être des offrandes de graines.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Statue = Un visage anguleux, des bras multiples, un regard qui suit tous les visiteurs.
orbis_horizon.chat.discovery.item.Furniture_Temple_Scarak_Window = Une fente taillée pour laisser passer exactement un rayon de soleil à midi.
orbis_horizon.chat.discovery.family.kweebec.name = Kweebec
orbis_horizon.chat.discovery.family.kweebec.lore = Les Kweebec vivent au cœur des forêts, dans des maisons de bois vivant et de feuillage. Leurs meubles sont petits, ronds et un peu de travers. On y voit plus de curiosité que de rigueur, et c'est très bien ainsi.
orbis_horizon.chat.discovery.family.kweebec.title = Compagnon des Kweebec
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Door = Basse et ronde, elle oblige tous les visiteurs à saluer en entrant.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Ladder = Les barreaux sont des branches à peine écorcées, encore un peu vertes.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Painting = Un paysage de sous-bois peint avec beaucoup d'amour et peu de perspective.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Platform = Une plateforme dans les branches, pour regarder passer les nuages en paix.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Shelf = Des champignons séchés, des graines et un galet qu'on a gardé sans raison.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Sign = Une flèche, un dessin de feuille. Impossible de savoir où elle mène.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Statue = Un petit personnage sculpté, le sourire un peu trop large pour son visage.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Stool = Une souche à peine travaillée. On s'y assied en balançant les pieds.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Table = Elle penche d'un côté, et personne n'a jamais songé à la redresser.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Trapdoor = Une trappe couverte de mousse. On ne la voit que si on la cherche.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Wardrobe = Des capes de feuilles tressées, soigneusement suspendues par ordre de saison.
orbis_horizon.chat.discovery.item.Furniture_Kweebec_Window = Une ouverture ronde où un oiseau a manifestement fait son nid.
orbis_horizon.chat.discovery.family.royal_magic.name = Magie royale
orbis_horizon.chat.discovery.family.royal_magic.lore = Dans les salons du Grand Magicien, tout semble vibrer d'un souffle contenu. Les tissus sont trop riches, l'or trop poli, les ombres un peu trop longues. Ici, même un fauteuil garde un secret.
orbis_horizon.chat.discovery.family.royal_magic.title = Familier de la cour
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Bed = Les draps de soie ne se froissent pas. Personne ne semble s'y être jamais couché.
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Chair = Un dossier haut, des accoudoirs sculptés. On s'y sent aussitôt jugé.
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Couch = Un canapé trop moelleux, où des conseillers ont dû dormir pendant les audiences.
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Medium_Door = Elle s'ouvre toute seule quand on hésite assez longtemps devant.
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Pot = Une fine fumée violette monte parfois du col, puis s'évanouit.
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Table = Des cercles de cire et d'encre marquent le plateau. On y préparait des sortilèges.
orbis_horizon.chat.discovery.item.Furniture_Royal_Magic_Wardrobe = Des robes brodées d'étoiles. L'une d'elles bouge un peu quand on regarde ailleurs.
orbis_horizon.chat.discovery.family.light_temple.name = Temple de la lumière
orbis_horizon.chat.discovery.family.light_temple.lore = Les temples de la lumière sont bâtis pour capter le moindre rayon. Les pierres pâles gardent la chaleur du jour jusque tard dans la nuit. On y marche à voix basse, comme dans un endroit qui n'a pas fini de prier.
orbis_horizon.chat.discovery.family.light_temple.title = Veilleur de la lumière
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Bed = Une dalle claire, creusée en son centre. Des offrandes s'y déposaient à l'aube.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Bench = Un long banc où des fidèles attendaient, les yeux fermés, que le soleil les trouve.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Door_Large = Chaque matin, elle s'ouvrait face à l'est pour laisser entrer la première lueur.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Door_Medilum = Les lignes dorées sur le battant forment un soleil à moitié effacé.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Painting = Un ciel peint à l'envers, avec le soleil tout en bas. Peut-être une prière.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Platform = On y montait pour recevoir la lumière avant les autres. Un honneur très envié.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Pot = Il contenait de l'eau claire, changée chaque jour selon un rituel oublié.
orbis_horizon.chat.discovery.item.Furniture_Temple_Light_Statue = Les yeux sont clos, les mains ouvertes. On parle bas près d'elle sans savoir pourquoi.
orbis_horizon.chat.discovery.family.ancient.name = Époque ancienne
orbis_horizon.chat.discovery.family.ancient.lore = Les objets de cette époque ont traversé tant de siècles que le bois a pris la couleur de la cendre. Personne ne sait qui les a faits ni pourquoi ils ont été laissés là. Dans les caves et les cryptes, on trouve encore des gestes figés, un sac posé, une torche prête à servir.
orbis_horizon.chat.discovery.family.ancient.title = Gardien des âges
orbis_horizon.chat.discovery.item.Furniture_Ancient_Barrel = Les cerceaux ont rouillé, mais le tonneau sonne encore creux quand on le frappe.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Coffin = Le couvercle a glissé d'un doigt. Quelqu'un a voulu vérifier, ou sortir.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Crate = Les planches se sont brisées vers l'extérieur, comme si on avait chargé trop vite.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Painting = Il reste une ligne d'horizon et deux silhouettes. Le reste est parti avec la peinture.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Pot = Le col est ébréché, mais la panse porte encore des motifs en spirale.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Sack = Rien dedans, sauf un grain de blé durci comme un caillou.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Statue = Le visage est lisse, mais les mains sont restées nettes. Elles tiennent quelque chose d'absent.
orbis_horizon.chat.discovery.item.Furniture_Ancient_Torch = La poix du bout est craquelée. Un seul éclat de silex suffirait peut-être.
orbis_horizon.chat.discovery.family.scarak_hive.name = Ruche Scarak
orbis_horizon.chat.discovery.family.scarak_hive.lore = Dans la ruche, tout est tunnel, résine et bourdonnement lointain. Les parois suintent d'une lueur chaude, et chaque recoin a son utilité. Ce monde est taillé pour une colonie, pas pour un voyageur isolé.
orbis_horizon.chat.discovery.family.scarak_hive.title = Éclaireur de la ruche
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Door_Large = Elle se referme lentement derrière vous, comme une mâchoire qui prend son temps.
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Door_Medium = Des fibres sèches la maintiennent. Elle craque à chaque passage de la colonie.
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Ladder = Une liane épaisse tapisse la paroi. Elle supporte étonnamment bien un poids.
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Lamp = La larve pulse doucement, comme si elle rêvait à voix basse.
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Lantern = Suspendue à un fil de soie, elle éclaire un couloir que personne ne balaie plus.
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Platform = Des couches de cire pressée forment ce plancher, collant par endroits.
orbis_horizon.chat.discovery.item.Furniture_Scarak_Hive_Window = Une ouverture irrégulière, rongée plutôt que taillée, par où passe un air tiède.
orbis_horizon.chat.discovery.family.dark_temple.name = Temple sombre
orbis_horizon.chat.discovery.family.dark_temple.lore = Le temple sombre garde ses couloirs dans une nuit qui n'a jamais lâché prise. Les Exilés y ont laissé des divinités de pierre et des bougies qui n'éclairent presque rien. On y avance à voix basse, avec le sentiment d'être regardé.
orbis_horizon.chat.discovery.family.dark_temple.title = Pèlerin des ténèbres
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Candle = La flamme ne vacille jamais, comme si l'air du temple retenait son souffle.
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Coffin = Il est plus étroit qu'un cercueil de village. Ses occupants n'étaient peut-être pas tout à fait comme nous.
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Door_Large = Elle s'ouvre vers l'intérieur, comme pour empêcher quelque chose de sortir.
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Door_Medium = Le seuil est creusé par des pas lents, tous dans le même sens.
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Pot = Une jarre scellée à la cire noire. On ne la secoue pas.
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Statue = Les yeux suivent celui qui passe. C'est peut-être la lumière, on préfère le croire.
orbis_horizon.chat.discovery.item.Furniture_Temple_Dark_Statue_Gaia = Une divinité des Exilés, les bras ouverts. Accueil ou avertissement, le carnet hésite.
orbis_horizon.chat.discovery.family.frozen_castle.name = Château givré
orbis_horizon.chat.discovery.family.frozen_castle.lore = Quelque part au nord, un château dort sous une croûte de glace épaisse comme une main. Ses salles sont restées en ordre, comme si les habitants étaient partis en une heure. Le gel a tout conservé, jusqu'au dernier souffle que l'on croit encore voir dans l'air.
orbis_horizon.chat.discovery.family.frozen_castle.title = Voyageur du grand gel
orbis_horizon.chat.discovery.item.Furniture_Frozen_Castle_Bed = Les draps sont devenus une plaque de glace. Il garde pourtant le creux d'un sommeil.
orbis_horizon.chat.discovery.item.Furniture_Frozen_Castle_Bench = Une rangée de givre en forme de personnes assises, à force de les imaginer.
orbis_horizon.chat.discovery.item.Furniture_Frozen_Castle_Lamp = La flamme est enfermée dans le verre depuis si longtemps qu'elle a presque l'air d'être de glace.
orbis_horizon.chat.discovery.item.Furniture_Frozen_Castle_Pot = Un vase fendu par le gel, mais les deux moitiés tiennent ensemble par la glace.
orbis_horizon.chat.discovery.item.Furniture_Frozen_Castle_Secondary_Lamp = Une lanterne jumelle, posée de l'autre côté de la salle, pour que personne ne marche dans le noir.
orbis_horizon.chat.discovery.item.Furniture_Frozen_Castle_Secondary_Pot = Un autre vase, plus petit, resté plein d'une eau devenue cristal.
orbis_horizon.chat.discovery.family.jungle.name = Jungle
orbis_horizon.chat.discovery.family.jungle.lore = Dans la jungle, tout pousse plus vite que l'on construit, alors on construit en bambou. Les cabanes sont légères, les cordes tendues, l'air chargé de pluie chaude. Chaque meuble sent la tige fraîche, et il suffit d'un orage pour que les lianes le reprennent.
orbis_horizon.chat.discovery.family.jungle.title = Marcheur des lianes
orbis_horizon.chat.discovery.item.Furniture_Jungle_Bookshelf = Les rouleaux sont serrés par des lanières de lianes. L'humidité les a presque tous gagnés.
orbis_horizon.chat.discovery.item.Furniture_Jungle_Brazier = Les braises sont couvertes de feuilles vertes, pour que la fumée chasse les moustiques.
orbis_horizon.chat.discovery.item.Furniture_Jungle_Painting = Des perroquets peints au jus de baies, un peu coulés par la mousson.
orbis_horizon.chat.discovery.item.Furniture_Jungle_Pot = Un vase tressé qui garde l'eau fraîche, pour peu qu'on le tienne à l'ombre.
orbis_horizon.chat.discovery.item.Furniture_Jungle_Pot_Secondary = Un second vase, plus trapu, qui sert de réserve pour les graines.
orbis_horizon.chat.discovery.family.wind_temple.name = Temple du vent
orbis_horizon.chat.discovery.family.wind_temple.lore = Le temple du vent est bâti là où l'air ne se repose jamais. Ses portes sifflent, ses voûtes chantent, et les statues y semblent attendre un souffle précis. On y entend toujours quelqu'un d'autre, et ce n'est presque jamais quelqu'un.
orbis_horizon.chat.discovery.family.wind_temple.title = Chercheur de souffle
orbis_horizon.chat.discovery.item.Furniture_Temple_Wind_Door_Large = Ses panneaux sont percés de petits trous. Elle joue une note quand le vent se lève.
orbis_horizon.chat.discovery.item.Furniture_Temple_Wind_Door_Medium = On l'ouvre d'une main, mais jamais en silence. Elle chante à chaque fois.
orbis_horizon.chat.discovery.item.Furniture_Temple_Wind_Pot = Embouchure étroite, panse large. Si on souffle dessus, il répond.
orbis_horizon.chat.discovery.item.Furniture_Temple_Wind_Statue = Une bête aux ailes immenses, figée en plein élan. Le vent semble toujours venir d'elle.
orbis_horizon.chat.discovery.item.Furniture_Temple_Wind_Statue_Gaia = Une divinité qui ne dit rien. Le plus étrange, c'est que le vent se taise autour d'elle.
orbis_horizon.chat.discovery.family.goblin.name = Gobelins
orbis_horizon.chat.discovery.family.goblin.lore = Les gobelins bâtissent avec ce qu'ils trouvent, et ils trouvent beaucoup de choses. Leurs repaires sentent la fumée, le métal chaud et la méfiance. On y repère vite ce qui a été fabriqué et ce qui a simplement été pris à quelqu'un d'autre.
orbis_horizon.chat.discovery.family.goblin.title = Pilleur de repaires
orbis_horizon.chat.discovery.item.Furniture_Goblin_Coffer = Un petit coffre qui murmure quand on s'éloigne. Mieux vaut ne pas lui tourner le dos.
orbis_horizon.chat.discovery.family.crude.name = Rudimentaire
orbis_horizon.chat.discovery.family.crude.lore = Avant les ateliers et les scieries, il y avait les troncs, les cordes et les mains. Ces meubles sont faits à la hâte et pour peu de temps, mais ils racontent la vie de ceux qui n'avaient que ça. Chacun porte la marque de son bricoleur.
orbis_horizon.chat.discovery.family.crude.title = Bricoleur de fortune
orbis_horizon.chat.discovery.item.Furniture_Crude_Brazier = Quelques pierres en cercle et des braises encore tièdes. Le campement vient de se vider.
orbis_horizon.chat.discovery.family.emerald_temple.name = Temple abandonné
orbis_horizon.chat.discovery.family.emerald_temple.lore = Quelque part sous les lianes, un temple vert dort depuis longtemps. Les racines ont soulevé les dalles et la mousse a mangé les noms. On y marche à voix basse, comme si les statues écoutaient.
orbis_horizon.chat.discovery.family.emerald_temple.title = Gardien du temple vert
orbis_horizon.chat.discovery.item.Furniture_Temple_Emerald_Bed = Des fougères poussent là où l'on posait la tête. Quelqu'un veillait ici, longtemps.
orbis_horizon.chat.discovery.item.Furniture_Temple_Emerald_Door_Medium = Une liane s'est glissée dans le chambranle. Elle ouvre ou elle retient, on ne sait pas.
orbis_horizon.chat.discovery.item.Furniture_Temple_Emerald_Statue = Une figurine de bois aux yeux creusés. La mousse lui a fait des sourcils.
orbis_horizon.chat.discovery.family.tavern.name = Taverne
orbis_horizon.chat.discovery.family.tavern.lore = Quelque part sur la route, une lanterne signale une taverne. On y trouve un feu, une chope et des histoires dont la moitié est vraie. Les meubles sont marqués par les coudes, les rires et les disputes oubliées avant l'aube.
orbis_horizon.chat.discovery.family.tavern.title = Habitué des tavernes
orbis_horizon.chat.discovery.item.Furniture_Tavern_Barrel = Il sonne creux, ce qui est rare un soir de marché. Le tavernier doit s'inquiéter.
orbis_horizon.chat.discovery.item.Furniture_Tavern_Painting = Un portrait du fondateur de la maison, trop flatteur pour être honnête.
orbis_horizon.chat.discovery.family.desert.name = Désert
orbis_horizon.chat.discovery.family.desert.lore = Dans les dunes, le vent efface les traces et rend les ruines au sable. Les meubles qui en émergent sont secs, craquelés et étrangement intacts. On devine un peuple qui savait vivre sous un soleil sans pitié.
orbis_horizon.chat.discovery.family.desert.title = Voyageur des dunes
orbis_horizon.chat.discovery.item.Furniture_Desert_Bed = Du sable s'est glissé dans chaque pli. Qui dormait ici est parti depuis longtemps.
orbis_horizon.chat.discovery.family.lumberjack.name = Bûcheron
orbis_horizon.chat.discovery.family.lumberjack.lore = Dans les forêts profondes, des cabanes se dressent près des souches fraîches. Les bûcherons y vivent au rythme de la hache et du feu, avec des meubles taillés dans le même bois qu'ils abattent. Tout sent la sève et la fumée.
orbis_horizon.chat.discovery.family.lumberjack.title = Compagnon des bois
orbis_horizon.chat.discovery.item.Furniture_Lumberjack_Painting = Une forêt peinte avec soin, accrochée par quelqu'un qui n'en voit jamais la fin.
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Bed = Lit
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Brazier = Brasero
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Chair = Chaise
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Chest_Small = Petit coffre
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Door = Porte
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Ladder = Échelle
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Sign = Pancarte
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Stool = Tabouret
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Table = Table
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Wardrobe = Armoire
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Window = Fenêtre
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Banner = Bannière
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Banner_Double = Bannière double
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Banner_Triple = Bannière triple
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Bench = Banc
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Bookshelf = Bibliothèque
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Candle = Bougie
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Coffin = Cercueil
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Desk = Comptoir
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Door_Large = Grande porte
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Door_Medium = Porte moyenne
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Lantern = Lanterne
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Lantern_Ceiling = Lanterne suspendue
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Planter = Jardinière
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Platform = Plateforme
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Pot = Vase
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Pot_Small = Petit vase
orbis_horizon.chat.discovery.name.Furniture_Human_Ruins_Shelf = Étagère
